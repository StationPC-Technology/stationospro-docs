# Public production origin used for canonical, Open Graph, and hreflang URLs.
NEXT_PUBLIC_SITE_URL=https://docs.stationpc.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side feedback forwarding (never expose the token to the client).
# The admin backend route is POST https://api.spcnasos.com/open-api/v1/feedback/help-center
# and the token must match that backend's open-api.feedback-token.
FEEDBACK_API_URL=
FEEDBACK_API_TOKEN=
